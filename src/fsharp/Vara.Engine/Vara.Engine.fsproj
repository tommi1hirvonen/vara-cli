<Project Sdk="Microsoft.NET.Sdk">

  <!-- Imperative shell: file system, storage, interop and the combinators that run the domain's decisions. -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Flow.fs" />
    <Compile Include="Kernel32.fs" />
    <Compile Include="Streams.fs" />
    <Compile Include="Hashing.fs" />
    <Compile Include="ContentStore.fs" />
    <Compile Include="SqliteManifest.fs" />
    <Compile Include="Scanner.fs" />
    <Compile Include="Signatures.fs" />
    <Compile Include="Execution.fs" />
    <Compile Include="RunLock.fs" />
    <Compile Include="RestoreRun.fs" />
    <Compile Include="PruneRun.fs" />
    <Compile Include="CheckRun.fs" />
    <Compile Include="PowerRequest.fs" />
    <Compile Include="BackupRun.fs" />
    <Compile Include="YamlConfig.fs" />
    <Compile Include="ConfigFile.fs" />
    <Compile Include="ProfileResolution.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.bundle_winsqlite3" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vara.Domain\Vara.Domain.fsproj" />
  </ItemGroup>

</Project>
