<Project Sdk="Microsoft.NET.Sdk">

  <!-- Imperative shell: file system, storage, interop and the combinators that run the domain's decisions. -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Foundation\Flow.fs" />
    <Compile Include="Foundation\FileSupport.fs" />
    <Compile Include="Foundation\Kernel32.fs" />
    <Compile Include="Foundation\Streams.fs" />
    <Compile Include="Foundation\Hashing.fs" />
    <Compile Include="Storage\ContentStore.fs" />
    <Compile Include="Storage\SqliteManifest.fs" />
    <Compile Include="Runs\Scanner.fs" />
    <Compile Include="Runs\Signatures.fs" />
    <Compile Include="Runs\Execution.fs" />
    <Compile Include="Runs\RunLock.fs" />
    <Compile Include="Runs\RestoreRun.fs" />
    <Compile Include="Runs\PruneRun.fs" />
    <Compile Include="Runs\CheckRun.fs" />
    <Compile Include="Runs\PowerRequest.fs" />
    <Compile Include="Runs\BackupRun.fs" />
    <Compile Include="Config\YamlConfig.fs" />
    <Compile Include="Config\ConfigFile.fs" />
    <Compile Include="Config\ProfileResolution.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.bundle_winsqlite3" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vara.Domain\Vara.Domain.fsproj" />
  </ItemGroup>

</Project>
