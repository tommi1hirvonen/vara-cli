<Project Sdk="Microsoft.NET.Sdk">

  <!-- Host and presentation: command tree, console output, Ctrl+C. Published as a single Native AOT vara.exe. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>vara</AssemblyName>
    <RootNamespace>Vara.Cli</RootNamespace>
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Output\Terminal.fs" />
    <Compile Include="Output\Prompts.fs" />
    <Compile Include="Output\PlainRenderer.fs" />
    <Compile Include="Output\LiveRenderer.fs" />
    <Compile Include="Output\KeyInput.fs" />
    <Compile Include="Output\RunProgress.fs" />
    <Compile Include="Output\JsonOutput.fs" />
    <Compile Include="Output\ErrorReporting.fs" />
    <Compile Include="CliEnv.fs" />
    <Compile Include="Output\TreeSession.fs" />
    <Compile Include="ProgressDisplay.fs" />
    <Compile Include="Commands\CommandAction.fs" />
    <Compile Include="Commands\BackupCommand.fs" />
    <Compile Include="Commands\HistorySession.fs" />
    <Compile Include="Commands\SnapshotsCommand.fs" />
    <Compile Include="Commands\SnapshotCommand.fs" />
    <Compile Include="Commands\HistoryCommand.fs" />
    <Compile Include="Commands\BrowseCommand.fs" />
    <Compile Include="Commands\DeletedCommand.fs" />
    <Compile Include="Commands\ShowCommand.fs" />
    <Compile Include="Commands\DiffCommand.fs" />
    <Compile Include="Commands\RestoreCommand.fs" />
    <Compile Include="Commands\PruneCommand.fs" />
    <Compile Include="Commands\CheckCommand.fs" />
    <Compile Include="Commands\ProfilesCommand.fs" />
    <Compile Include="GracefulCancellation.fs" />
    <Compile Include="Composition.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="DiffPlex" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vara.Domain\Vara.Domain.fsproj" />
    <ProjectReference Include="..\Vara.Engine\Vara.Engine.fsproj" />
  </ItemGroup>

</Project>
